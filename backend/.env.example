# Copy this file to .env and fill in real values. Never commit .env.

# ── Server ──
NODE_ENV=development
PORT=5000
# Site origins allowed to call the API, comma-separated
FRONTEND_URL=http://localhost:5173
# Proxies in front of the app: 0 locally, 1 on Vercel/Render
TRUST_PROXY=0

# ── Outgoing mail (SMTP) ──
# Google Workspace / Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=info@yourdomain.com, SMTP_PASS=<16-char App Password>
# Resend: SMTP_HOST=smtp.resend.com, SMTP_USER=resend,      SMTP_PASS=<Resend API key>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Address emails are sent from (with Gmail it must match SMTP_USER)
MAIL_FROM=

# ── Where enquiries go (comma-separated for several inboxes) ──
COMPANY_EMAIL=
# Optional: separate inbox for quote requests (defaults to COMPANY_EMAIL)
QUOTE_EMAIL=
